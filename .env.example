# MongoDB en servidor remoto (IP o DNS).
MONGO_DETAILS=mongodb://192.168.1.100:27017/

# Opcional: timeouts en ms (si la red es lenta; no arregla firewall que bloquee al contenedor).
# MONGO_SERVER_SELECTION_TIMEOUT_MS=45000
# MONGO_CONNECT_TIMEOUT_MS=20000

# Si Compass conecta pero Docker da ServerSelectionTimeoutError a la MISMA IP: el contenedor sale con
# otra IP origen; permite en el firewall de Mongo/servidor el rango de Docker o usa:
#   docker compose -f docker-compose.yml -f docker-compose.host-network.yml up
# (solo si tu Docker corre en Linux; ver comentarios en docker-compose.host-network.yml).

BD_DETAILS=integrado

# MySQL — credenciales (mismo usuario/clave en el contenedor mysql y en la API)
MYSQL_USER=ztrack2023
MYSQL_PASSWORD=lpmp2018
MYSQL_DATABASE=zgroupztrack
MYSQL_ROOT_PASSWORD=root

# Puerto MySQL en el host (opcional). Por defecto 3306.
# MYSQL_PUBLISH_PORT=3306

# Ejecutar la API fuera de Docker (venv): usa localhost.
MYSQL_HOST=localhost

# Docker Compose: la API ya usa el hostname del servicio (mysql). Solo cambia si renombraras el servicio:
# DOCKER_MYSQL_HOST=mysql
